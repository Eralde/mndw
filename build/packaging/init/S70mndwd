#!/bin/sh

PID_FILE="/opt/var/run/mndwd.pid"
DAEMON="/opt/sbin/mndwd"
DATA_DIR="/opt/var/lib/mndw"
KEY_DIR="/opt/var/lib/mndw-secrets"
PLUGIN_RUNTIME_DIR="$DATA_DIR/plugin-runtime"
LOG_FILE="/opt/var/log/mndwd.log"

wait_for_exit() {
  wait_pid="$1"
  wait_seconds="$2"
  while [ "$wait_seconds" -gt 0 ] && kill -0 "$wait_pid" 2>/dev/null; do
    sleep 1
    wait_seconds=$((wait_seconds - 1))
  done
  ! kill -0 "$wait_pid" 2>/dev/null
}

reap_mwsd() {
  reap_failed=0
  for mwsd_pidfile in "$PLUGIN_RUNTIME_DIR"/*/mwsd.pid; do
    [ -f "$mwsd_pidfile" ] || continue
    mwsd_pid=$(cat "$mwsd_pidfile" 2>/dev/null || true)
    [ -n "$mwsd_pid" ] || continue
    mwsd_comm=$(cat "/proc/$mwsd_pid/comm" 2>/dev/null || true)
    [ "$mwsd_comm" = "mwsd" ] || continue
    [ "$(cat "$mwsd_pidfile" 2>/dev/null || true)" = "$mwsd_pid" ] || continue

    kill "$mwsd_pid" 2>/dev/null || true
    if ! wait_for_exit "$mwsd_pid" 10; then
      current_mwsd_pid=$(cat "$mwsd_pidfile" 2>/dev/null || true)
      if [ "$current_mwsd_pid" = "$mwsd_pid" ]; then
        kill -KILL "$mwsd_pid" 2>/dev/null || true
        wait_for_exit "$mwsd_pid" 2
      fi
    fi
    if kill -0 "$mwsd_pid" 2>/dev/null; then
      reap_failed=1
      continue
    fi
    mwsd_runtime_dir=${mwsd_pidfile%/mwsd.pid}
    rm -f "$mwsd_pidfile" "$mwsd_runtime_dir/mwsd.sock"
  done
  return "$reap_failed"
}

start() {
  mkdir -p /opt/var/run "$DATA_DIR" "$KEY_DIR" "$PLUGIN_RUNTIME_DIR"
  chmod 700 "$DATA_DIR" "$KEY_DIR" "$PLUGIN_RUNTIME_DIR"

  # Always regenerate proxy config on boot (IP may have changed).
  ROUTER_IP="$(ip -4 addr show br0 2>/dev/null | awk '/inet / {print $2}' | cut -d/ -f1 | head -n1)"
  ROUTER_IP="${ROUTER_IP:-192.168.1.1}"

  cat > "$DATA_DIR/proxy-target.conf" <<EOF
proxy.server = ( "" => (( "host" => "$ROUTER_IP", "port" => 80 )) )
proxy.header = (
  "map-host-request"  => ( "-" => "$ROUTER_IP" ),
  "map-host-response" => ( "$ROUTER_IP" => "-" )
)
EOF

  # PID guard AFTER proxy-target.conf is written.
  if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
    return 0
  fi

  "$DAEMON" \
    --listen "127.0.0.1:9090" \
    --data-dir "$DATA_DIR" \
    --rci-session-state-dir "$DATA_DIR" \
    --rci-session-key-dir "$KEY_DIR" \
    --builtin-plugins-dir "/opt/share/www/mndw/plugins" \
    --user-plugins-dir "/opt/share/www/mndw/user-plugins" \
    --router-url "http://$ROUTER_IP" \
    --opkg exec \
    >> "$LOG_FILE" 2>&1 &
  echo "$!" > "$PID_FILE"
}

stop() {
  if [ ! -f "$PID_FILE" ]; then
    reap_mwsd
    return $?
  fi
  pid="$(cat "$PID_FILE" 2>/dev/null || true)"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null || true
    if ! wait_for_exit "$pid" 60; then
      current_pid="$(cat "$PID_FILE" 2>/dev/null || true)"
      if [ "$current_pid" = "$pid" ]; then
        kill -KILL "$pid" 2>/dev/null || true
        wait_for_exit "$pid" 2
      fi
    fi
  fi
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    return 1
  fi
  rm -f "$PID_FILE"
  reap_mwsd
}

restart() { stop || return 1; start; }

case "$1" in
  start)   start ;;
  stop)    stop ;;
  restart) restart ;;
  *)       echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
