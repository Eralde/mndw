{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mndw/plugin-manifest.schema.json",
  "title": "mndw plugin manifest",
  "description": "Manifest for an mndw plugin (widget or page). Generated from the Zod schema — do not edit by hand; run `pnpm generate-manifest-schema`.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "manifestVersion": {
          "type": "number",
          "const": 2,
          "description": "Manifest format version. Must be 2."
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Unique plugin id: lowercase alphanumeric with hyphens (e.g. my-widget). Used as the on-disk folder and URL segment."
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "Semver-ish version string (e.g. 2.0.0)."
        },
        "type": {
          "type": "string",
          "const": "widget"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable name shown in the dashboard / navigation."
        },
        "entry": {
          "type": "string",
          "minLength": 1,
          "description": "Relative path to the bundled entry module, served from /plugins/<name>/<entry> (e.g. index.js)."
        },
        "icon": {
          "description": "Optional icon name shown next to the plugin in the UI.",
          "type": "string"
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "persistent-rci-session"
            ]
          }
        },
        "size": {
          "type": "object",
          "properties": {
            "w": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 12,
              "description": "Initial widget width in grid columns (1-12)."
            },
            "h": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "description": "Initial widget height in grid rows."
            },
            "minW": {
              "description": "Minimum widget width in grid columns; must be <= w.",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 12
            },
            "minH": {
              "description": "Minimum widget height in grid rows; must be <= h.",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "w",
            "h"
          ],
          "additionalProperties": false,
          "description": "Widget size in grid units on the 12-column dashboard grid."
        },
        "fixedHeight": {
          "type": "boolean"
        },
        "backend": {
          "type": "object",
          "properties": {
            "opkg": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9+_.-]*$"
              }
            },
            "scripts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "runtime": {
                    "type": "string",
                    "const": "sh"
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id",
                  "runtime",
                  "source"
                ],
                "additionalProperties": false
              }
            },
            "assets": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "endpoints": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "method": {
                    "type": "string",
                    "enum": [
                      "GET",
                      "POST",
                      "PUT",
                      "PATCH",
                      "DELETE"
                    ]
                  },
                  "scriptId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "csrf": {
                    "type": "boolean"
                  },
                  "sensitive": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "id",
                  "path",
                  "method",
                  "scriptId"
                ],
                "additionalProperties": false
              }
            },
            "websockets": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "target": {
                    "type": "string",
                    "minLength": 1
                  },
                  "protocols": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "id",
                  "path",
                  "target"
                ],
                "additionalProperties": false
              }
            },
            "daemon": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "string",
                  "minLength": 1
                },
                "stop": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "start",
                "stop"
              ],
              "additionalProperties": false
            },
            "public": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "manifestVersion",
        "name",
        "version",
        "type",
        "label",
        "entry",
        "size"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
