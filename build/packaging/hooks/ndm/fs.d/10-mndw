#!/bin/sh
HOOK_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd) || exit 0
. "$HOOK_ROOT/mndw-hook-common.sh"
action=${1:-}
payload="\"label\":\"$(escape "${label:-}")\",\"directory\":\"$(escape "${directory:-}")\""
if [ "$action" = stop ]; then post "{\"hook\":\"fs.d\",\"action\":\"stop\",\"payload\":{$payload}}"; else post "{\"hook\":\"fs.d\",\"action\":\"start\",\"payload\":{\"type\":\"$(escape "${type:-}")\",$payload}}"; fi
