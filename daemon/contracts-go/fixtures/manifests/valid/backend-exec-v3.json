{
  "manifestVersion": 3,
  "name": "exec-v3-plugin",
  "version": "3.0.0",
  "type": "widget",
  "label": "Exec V3",
  "entry": "index.js",
  "size": {"w": 4, "h": 3},
  "backend": {
    "kind": "exec",
    "packages": ["jq"],
    "routes": [
      {"id": "echo", "transport": "http", "method": "post", "path": "echo", "command": "backend/echo.sh"},
      {"id": "health", "transport": "http", "method": "GET", "path": "health", "access": "public", "command": "backend/health.sh"}
    ]
  }
}
