{
  "name": "@mndw/host",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @mndw/ui generate-icons && tsx scripts/bundle-shared.ts && vite",
    "build": "pnpm --filter @mndw/ui generate-icons && vite build && tsx scripts/bundle-shared.ts",
    "build:dev-host": "pnpm --filter @mndw/ui generate-icons && vite build --mode dev-host --outDir dist-dev-host && node --import tsx scripts/bundle-shared.ts --out dist-dev-host/shared",
    "preview": "vite preview",
    "bundle-shared": "tsx scripts/bundle-shared.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@mndw/sdk": "workspace:*",
    "@mndw/sdk-internal": "workspace:*",
    "@mndw/ui": "workspace:*",
    "@mndw/ui-svelte": "workspace:*",
    "@rci-tools/core": "catalog:",
    "gridstack": "^12.6.0",
    "hash-wasm": "^4.12.0",
    "rxjs": "^7.8.0",
    "sv-router": "^0.14.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@angular/common": "^21.2.18",
    "@angular/compiler": "^21.2.18",
    "@angular/core": "^21.2.18",
    "@angular/platform-browser": "^21.2.18",
    "@mndw/angular-compiler": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "22.19.15",
    "@vitejs/plugin-vue": "^6.0.0",
    "d3": "^7.9.0",
    "esbuild": "^0.25.0",
    "happy-dom": "^20.11.1",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.2",
    "tsx": "^4.23.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "vue": "^3.5.39",
    "zone.js": "^0.15.1"
  }
}
