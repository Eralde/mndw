{
  "name": "@mndw/ui-vue",
  "version": "0.1.4",
  "license": "MIT",
  "homepage": "https://eralde.github.io/mndw/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eralde/mndw.git",
    "directory": "frontend/ui-vue"
  },
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mndw/ui": "workspace:^"
  },
  "peerDependencies": {
    "vue": ">=3.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "happy-dom": "20.11.1",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7",
    "vue": "^3.5.39"
  },
  "description": "Vue table cell adapters for mndw UI."
}
