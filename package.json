{
  "name": "mndw",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx tools/dev.ts",
    "dev-plugin": "pnpm exec mndw dev",
    "test": "pnpm -r --if-present test",
    "gen-tokens": "pnpm --filter @mndw/palette-tools gen-tokens",
    "generate-manifest-schema": "pnpm --filter @mndw/sdk generate-manifest-schema",
    "build-example-plugins": "tsx packages/cli/src/index.ts pack-examples --out-dir example-plugins/dist",
    "build-ipk": "tsx tools/build-ipk.ts",
    "fmt": "dprint fmt \"packages/**/*.*\" \"example-plugins/**/*.*\" \"tools/dev.ts\" \"tools/build-ipk.ts\" \"tools/build-ipk.test.ts\"",
    "lint": "eslint --fix --no-error-on-unmatched-pattern \"packages/\" \"example-plugins/\" \"tools/dev.ts\" \"tools/build-ipk.ts\" \"tools/build-ipk.test.ts\"",
    "lint-styles": "stylelint --config .stylelintrc.js \"**/*.scss\" --fix && stylelint --config .stylelintrc.css.js \"**/*.css\" --fix"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@eslint/compat": "2.0.3",
    "@eslint/js": "9.39.4",
    "@mndw/cli": "workspace:*",
    "@mndw/sdk": "workspace:*",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "22.19.15",
    "@typescript-eslint/types": "8.57.1",
    "dprint": "^0.53.2",
    "esbuild": "^0.25.12",
    "esbuild-svelte": "^0.9.5",
    "eslint": "9.39.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "62.8.0",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "eslint-plugin-svelte": "^3.20.0",
    "eslint-plugin-vue": "^10.9.2",
    "fast-glob": "3.3.3",
    "stylelint": "^17.14.0",
    "stylelint-config-hudochenkov": "^13.0.2",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-no-unsupported-browser-features": "^8.1.1",
    "stylelint-order": "^8.1.1",
    "stylelint-scss": "^7.2.0",
    "svelte": "^5.56.4",
    "svelte-eslint-parser": "^1.8.0",
    "tsx": "^4.23.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "8.57.1",
    "vue-eslint-parser": "^10.4.1"
  }
}
