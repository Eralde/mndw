{
  "manifestVersion": 3,
  "name": "terminal-page",
  "version": "0.1.0",
  "type": "page",
  "route": "/terminal",
  "label": "Terminal",
  "entry": "index.js",
  "i18n": {"defaultLocale": "en", "locales": {"en": "i18n/en.json", "ru": "i18n/ru.json"}},
  "backend": {
    "kind": "service",
    "protocolVersion": 1,
    "command": "backend/terminal-backend",
    "packages": ["ttyd"],
    "routes": [
      {"id": "spawn", "transport": "http", "method": "POST", "path": "spawn"},
      {"id": "kill", "transport": "http", "method": "POST", "path": "kill"},
      {"id": "terminal", "transport": "websocket", "path": "terminal", "protocols": ["tty"]}
    ]
  }
}
