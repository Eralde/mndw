{
  "name": "@mndw/ui-svelte",
  "version": "0.1.6",
  "license": "MIT",
  "homepage": "https://eralde.github.io/mndw/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eralde/mndw.git",
    "directory": "frontend/ui-svelte"
  },
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "svelte": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/fixtures"
  ],
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@mndw/ui": "workspace:^"
  },
  "peerDependencies": {
    "svelte": ">=5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "catalog:",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "happy-dom": "20.11.1",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.2",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  },
  "description": "Svelte table cell adapters for mndw UI."
}
