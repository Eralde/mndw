{
  "name": "@mndw/sdk",
  "version": "1.0.0",
  "license": "MIT",
  "homepage": "https://eralde.github.io/mndw/",
  "repository": {"type": "git", "url": "git+https://github.com/Eralde/mndw.git", "directory": "frontend/sdk"},
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens.css": "./src/tokens.css",
    "./tokens": {
      "types": "./src/tokens.ts",
      "default": "./src/tokens.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    },
    "./testing/vitest-project": {
      "types": "./src/testing/vitest-project.ts",
      "default": "./src/testing/vitest-project.ts"
    },
    "./svelte": {
      "types": "./src/svelte/index.ts",
      "default": "./src/svelte/index.ts"
    },
    "./vue": {
      "types": "./src/vue/index.ts",
      "default": "./src/vue/index.ts"
    },
    "./angular": {
      "types": "./src/angular/index.ts",
      "default": "./src/angular/index.ts"
    },
    "./bind-locale": {
      "types": "./src/bind-locale.ts",
      "default": "./src/bind-locale.ts"
    },
    "./refresh": {
      "types": "./src/refresh.ts",
      "default": "./src/refresh.ts"
    },
    "./rrd": {
      "types": "./src/rrd.ts",
      "default": "./src/rrd.ts"
    },
    "./manifest.schema.json": "./manifest.schema.json"
  },
  "files": ["dist", "README.md"],
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {"types": "./dist/index.d.ts", "default": "./dist/index.js"},
      "./tokens.css": "./dist/tokens.css",
      "./tokens": {"types": "./dist/tokens.d.ts", "default": "./dist/tokens.js"},
      "./testing": {"types": "./dist/testing/index.d.ts", "default": "./dist/testing/index.js"},
      "./testing/vitest-project": {"types": "./dist/testing/vitest-project.d.ts", "default": "./dist/testing/vitest-project.js"},
      "./svelte": {"types": "./dist/svelte/index.d.ts", "default": "./dist/svelte/index.js"},
      "./vue": {"types": "./dist/vue/index.d.ts", "default": "./dist/vue/index.js"},
      "./angular": {"types": "./dist/angular/index.d.ts", "default": "./dist/angular/index.js"},
      "./bind-locale": {"types": "./dist/bind-locale.d.ts", "default": "./dist/bind-locale.js"},
      "./refresh": {"types": "./dist/refresh.d.ts", "default": "./dist/refresh.js"},
      "./rrd": {"types": "./dist/rrd.d.ts", "default": "./dist/rrd.js"},
      "./manifest.schema.json": "./dist/manifest.schema.json"
    }
  },
  "scripts": {
    "test": "vitest run",
    "generate-manifest-schema": "pnpm --filter @mndw/sdk-internal generate-manifest-schema",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').copyFileSync('src/tokens.css', 'dist/tokens.css'); require('node:fs').copyFileSync('manifest.schema.json', 'dist/manifest.schema.json')\"",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@mndw/palette-core": "workspace:*",
    "intl-messageformat": "^11.2.13",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@rci-tools/core": "^0.6.0",
    "rxjs": ">=7.0.0",
    "@angular/core": ">=21.0.0",
    "@angular/platform-browser": ">=21.0.0",
    "svelte": ">=5.0.0",
    "vue": ">=3.0.0",
    "vitest": "^3"
  },
  "peerDependenciesMeta": {
    "@angular/core": {"optional": true},
    "@angular/platform-browser": {"optional": true},
    "svelte": {"optional": true},
    "vue": {"optional": true},
    "vitest": {"optional": true}
  },
  "devDependencies": {
    "@angular/common": "^21.2.18",
    "@angular/compiler": "^21.2.18",
    "@angular/core": "^21.2.18",
    "@angular/platform-browser": "^21.2.18",
    "@rci-tools/core": "catalog:",
    "happy-dom": "20.11.1",
    "rxjs": "^7.8.0",
    "svelte": "^5.56.4",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7",
    "vue": "^3.5.39",
    "zone.js": "^0.15.1"
  }
}
