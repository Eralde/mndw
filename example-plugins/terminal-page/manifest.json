{
  "$schema": "../../packages/sdk/manifest.schema.json",
  "manifestVersion": 2,
  "name": "terminal-page",
  "version": "0.1.0",
  "type": "page",
  "route": "/terminal",
  "label": "Terminal",
  "entry": "index.js",
  "backend": {
    "opkg": ["ttyd", "daemonize"],
    "daemon": {"start": "backend/spawn_ttyd.sh", "stop": "backend/kill_ttyd.sh"},
    "scripts": [
      {"id": "spawn", "runtime": "sh", "source": "backend/spawn_ttyd.sh"},
      {"id": "kill", "runtime": "sh", "source": "backend/kill_ttyd.sh"}
    ],
    "endpoints": [
      {"id": "spawn", "method": "POST", "path": "spawn", "scriptId": "spawn"},
      {"id": "kill", "method": "POST", "path": "kill", "scriptId": "kill"}
    ],
    "websockets": [
      {"id": "terminal", "path": "terminal", "target": "127.0.0.1:7681", "protocols": ["tty"]}
    ]
  }
}
