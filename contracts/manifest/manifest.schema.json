                    "type": "string",
                    "minLength": 1
                  }
                },
                "packages": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9+_.-]*$"
                  }
                },
                "routes": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "transport": {
                            "type": "string",
                            "const": "http"
                          },
                          "method": {
                            "type": "string",
                            "enum": [
                              "GET",
                              "HEAD",
                              "POST",
                              "PUT",
                              "PATCH",
                              "DELETE"
                            ]
                          },
                          "path": {
                            "type": "string"
                          },
                          "access": {
                            "default": "session",
                            "type": "string",
                            "enum": [
                              "session",
                              "public"
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "transport",
                          "method",
                          "path",
                          "access"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "transport": {
                            "type": "string",
                            "const": "websocket"
                          },
                          "path": {
                            "type": "string"
                          },
                          "access": {
                            "default": "session",
                            "type": "string",
                            "enum": [
                              "session",
                              "public"
                            ]
                          },
                          "protocols": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        },
                        "required": [
                          "id",
                          "transport",
                          "path",
                          "access"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                }
              },
              "required": [
                "kind",
                "protocolVersion",
                "command",
                "routes"
              ],
              "additionalProperties": false
            }
          ]
        },
        "type": {
          "type": "string",
          "const": "widget"
        },
        "size": {
          "type": "object",
          "properties": {
            "w": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 12
            },
            "h": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "minW": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 12
            },
            "minH": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "w",
            "h"
          ],
          "additionalProperties": false
        },
        "fixedHeight": {
          "type": "boolean"
        }
      },
      "required": [
        "manifestVersion",
        "name",
        "version",
        "label",
        "entry",
        "type",
        "size"
      ],
      "additionalProperties": false
    },
