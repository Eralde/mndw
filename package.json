{
  "name": "mndw",
  "version": "0.1.5",
  "private": true,
  "license": "MIT",
  "scripts": {
    "docs:api": "typedoc --options build/docs/typedoc.json",
    "docs:dev": "pnpm docs:api && vitepress dev docs/plugin-author",
    "docs:build": "pnpm docs:api && vitepress build docs/plugin-author",
    "docs:preview": "vitepress preview docs/plugin-author",
    "test:docs:e2e": "pnpm docs:build && pnpm test:docs:e2e:run",
    "test:docs:e2e:run": "playwright test --config build/docs-e2e/playwright.config.ts",
    "test:docs": "pnpm --filter @mndw/ui generate-icons && pnpm --filter @mndw/palette-tools exec vitest run --root ../.. build/docs",
    "dev": "tsx build/dev/dev.ts",
    "dev-plugin": "pnpm exec mndw dev",
    "test": "pnpm --filter @mndw/ui generate-icons && pnpm -r --no-bail --if-present test && pnpm test:build && pnpm test:px-audit && pnpm test:npm && pnpm test:docs",
    "test:build": "node --import tsx build/scripts/run-build-tests.ts",
    "test:px-audit": "pnpm --filter @mndw/palette-tools exec vitest run --root ../.. build/scripts/audit-px.test.ts",
    "test:npm": "pnpm --filter @mndw/palette-tools exec vitest run --root ../.. build/npm",
    "lint:px": "node build/scripts/audit-px.mjs",
    "gen-tokens": "pnpm --filter @mndw/palette-tools gen-tokens",
    "generate-manifest-schema": "pnpm --filter @mndw/sdk-internal generate-manifest-schema",
    "generate-contracts": "node --import tsx build/contracts/generate.ts",
    "build": "node --import tsx build/index.ts build",
    "build-builtin-plugins": "node --import tsx build/builtin-plugins.ts",
    "build-example-plugins": "node --import tsx build/example-plugins.ts",
    "build-ipk": "node --import tsx build/packaging/build-ipk.ts",
    "pack-npm": "node --import tsx build/npm/pack-all.ts",
    "smoke-npm": "node --import tsx build/npm/fresh-project-smoke.ts",
    "fmt": "dprint fmt \"packages/**/*.*\" \"frontend/**/*.*\" \"tooling/**/*.*\" \"plugins/builtin/**/*.*\" \"plugins/examples/**/*.*\" \"build/**/*.*\"",
    "fmt:go": "sh build/fmt-go.sh -w",
    "fmt:go:check": "sh build/fmt-go.sh --check",
    "lint": "run-s --continue-on-error lint:cached lint:svelte lint:px",
    "lint:cached": "eslint --cache --cache-location .cache/eslint-nonsvelte --fix --no-error-on-unmatched-pattern --ignore-pattern \"**/*.svelte\" --ignore-pattern \"**/*.svelte.ts\" \"packages/\" \"frontend/\" \"tooling/\" \"plugins/builtin/\" \"plugins/examples/\" \"build/\" \"docs/plugin-author/.vitepress/\"",
    "lint:svelte": "eslint --no-cache --fix --no-error-on-unmatched-pattern \"packages/**/*.svelte\" \"packages/**/*.svelte.ts\" \"frontend/**/*.svelte\" \"frontend/**/*.svelte.ts\" \"tooling/**/*.svelte\" \"tooling/**/*.svelte.ts\" \"plugins/builtin/**/*.svelte\" \"plugins/builtin/**/*.svelte.ts\" \"plugins/examples/**/*.svelte\" \"plugins/examples/**/*.svelte.ts\" \"build/**/*.svelte\" \"build/**/*.svelte.ts\"",
    "lint-styles": "stylelint --config .stylelintrc.js \"**/*.scss\" --fix && stylelint --config .stylelintrc.css.js \"**/*.css\" --fix",
    "knip": "knip --no-progress",
    "build-mndwd-npm": "node --import tsx build/npm/mndwd-packages.ts"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@eslint/compat": "2.0.3",
    "@eslint/js": "9.39.4",
    "@mndw/cli": "workspace:*",
    "@mndw/sdk-internal": "workspace:*",
    "@mndw/sdk": "workspace:*",
    "@mndw/ui": "workspace:*",
    "@playwright/test": "^1.52.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "22.19.15",
    "@types/tar-stream": "^3.1.4",
    "cross-spawn": "^7.0.6",
    "d3": "^7.9.0",
    "dprint": "^0.53.2",
    "eslint": "9.39.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "62.8.0",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "eslint-plugin-svelte": "^3.20.0",
    "eslint-plugin-vue": "^10.9.2",
    "knip": "^6.32.2",
    "markdown-it": "^14.3.3",
    "npm-run-all2": "9.0.3",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.14.0",
    "stylelint-config-hudochenkov": "^13.0.2",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-scss": "^7.2.0",
    "svelte": "^5.56.4",
    "svelte-eslint-parser": "^1.8.0",
    "tar-stream": "^3.2.1",
    "tsx": "^4.23.0",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.1",
    "typedoc-vitepress-theme": "1.1.3",
    "typescript": "^5.7.0",
    "typescript-eslint": "8.57.1",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.7",
    "vue-eslint-parser": "^10.4.1"
  }
}
