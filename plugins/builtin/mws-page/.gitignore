# Workspace dependencies and package build output
/node_modules/
/dist/
/.ngc-cache/
/.cache/
/.eslintcache

# Locally compiled backend binaries; packaging rebuilds these from backend/
/backend/mwsd
/backend/mwsd-client

# Bundled reference implementation generated by build-reference.ts
/scripts/auth-reference/generated/

# Only ignored when a local manual run places runtime files beside backend/
/backend/*.pid
/backend/*.sock
