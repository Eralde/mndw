#!/bin/sh
HOOK_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd) || exit 0
. "$HOOK_ROOT/mndw-hook-common.sh"
elapsed=${elapsed:-0}
case $elapsed in
	''|*[!0-9]*) elapsed=0 ;;
	*)
		elapsed=$(printf '%s' "$elapsed" | sed 's/^0*//')
		[ -n "$elapsed" ] || elapsed=0
		;;
esac
post "{\"hook\":\"schedule.d\",\"action\":\"$(escape "${1:-start}")\",\"payload\":{\"schedule\":\"$(escape "${schedule:-}")\",\"elapsed\":$elapsed}}"
