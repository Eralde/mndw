                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "transport": {
                        "type": "string",
                        "const": "http"
                      },
                      "method": {
                        "type": "string",
                        "enum": [
                          "GET",
                          "HEAD",
                          "POST",
                          "PUT",
                          "PATCH",
                          "DELETE"
                        ]
                      },
                      "path": {
                        "type": "string"
                      },
                      "access": {
                        "default": "session",
                        "type": "string",
                        "enum": [
                          "session",
                          "public"
                        ]
                      },
                      "command": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "id",
                      "transport",
                      "method",
                      "path",
                      "access",
                      "command"
                    ],
                    "additionalProperties": false
                  }
                }
