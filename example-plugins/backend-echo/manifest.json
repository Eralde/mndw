{
  "$schema": "../../packages/sdk/manifest.schema.json",
  "manifestVersion": 2,
  "name": "backend-echo",
  "version": "0.1.0",
  "type": "widget",
  "label": "Backend Echo",
  "entry": "index.js",
  "size": {"w": 4, "h": 3, "minW": 3, "minH": 2},
  "backend": {
    "scripts": [{"id": "echo", "runtime": "sh", "source": "backend/echo.cgi"}],
    "endpoints": [
      {"id": "echoGet", "method": "GET", "path": "echo", "scriptId": "echo"},
      {"id": "echoPost", "method": "POST", "path": "echo", "scriptId": "echo"}
    ]
  }
}
