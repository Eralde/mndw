{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mndw/plugin-manifest.schema.json",
  "title": "mndw plugin manifest",
  "description": "Manifest for an mndw plugin (widget or page). Generated from the Zod schema — do not edit by hand; run `pnpm generate-contracts`.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "manifestVersion": {
          "type": "number",
          "const": 1,
          "description": "Manifest format version. Must be 1."
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Unique plugin id used as the on-disk folder and URL segment."
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "Semver-ish version string."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable name shown in the dashboard or navigation."
        },
        "entry": {
          "type": "string",
          "minLength": 1,
          "description": "Relative path to the bundled entry module."
        },
        "icon": {
          "description": "Optional icon name.",
          "type": "string"
        },
        "permissions": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "persistent-rci-session:read",
                  "persistent-rci-session:write"
                ]
              },
              {
                "type": "string",
                "pattern": "^events:(\\*|[a-z][a-z0-9]*(?:,[a-z][a-z0-9]*)*)$"
              }
            ]
          }
        },
        "i18n": {
          "type": "object",
          "properties": {
            "defaultLocale": {
              "type": "string",
              "minLength": 1
            },
            "locales": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "defaultLocale",
            "locales"
          ],
          "additionalProperties": false
        },
        "backend": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "exec"
                },
                "packages": {
                  "type": "array",
