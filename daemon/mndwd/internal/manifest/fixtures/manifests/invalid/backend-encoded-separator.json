{
  "manifestVersion": 1,
  "name": "service-encoded-separator",
  "version": "3.0.0",
  "type": "page",
  "label": "Service Backend",
  "entry": "index.js",
  "route": "/service",
  "backend": {
    "kind": "service",
    "protocolVersion": 1,
    "command": "backend/server",
    "args": ["--foreground"],
    "packages": ["ttyd"],
    "routes": [
      {"id": "status", "transport": "http", "method": "GET", "path": "a%2Fb"},
      {"id": "terminal", "transport": "websocket", "path": "terminal", "protocols": ["tty"]}
    ]
  }
}
