                  "target"
                ],
                "additionalProperties": false
              }
            },
            "daemon": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "string",
                  "minLength": 1
                },
                "stop": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "start",
