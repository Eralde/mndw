#!/bin/sh
HOOK_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd) || exit 0
. "$HOOK_ROOT/mndw-hook-common.sh"
MNDW_WAN_INTERFACE_FILE=${MNDW_WAN_INTERFACE_FILE:-$MNDW_ROOT/var/lib/mndw/wan-interface}
action=${1:-}
interface=$(escape "${interface:-}")
if [ "$action" = stop ]; then
	if [ -z "$interface" ] && [ -r "$MNDW_WAN_INTERFACE_FILE" ]; then
		interface=$(cat "$MNDW_WAN_INTERFACE_FILE" 2>/dev/null || true)
	fi
	[ -n "$interface" ] || exit 0
	post "{\"hook\":\"wan.d\",\"action\":\"stop\",\"payload\":{\"interface\":\"$interface\"}}"
	rm -f "$MNDW_WAN_INTERFACE_FILE"
else
	if [ -n "$interface" ]; then
		mkdir -p "$(dirname "$MNDW_WAN_INTERFACE_FILE")" 2>/dev/null
		printf '%s\n' "$interface" >"$MNDW_WAN_INTERFACE_FILE" 2>/dev/null || true
	fi
	post "{\"hook\":\"wan.d\",\"action\":\"start\",\"payload\":{\"interface\":\"$interface\",\"address\":\"$(escape "${address:-}")\",\"mask\":\"$(escape "${mask:-}")\",\"gateway\":\"$(escape "${gateway:-}")\"}}"
fi
