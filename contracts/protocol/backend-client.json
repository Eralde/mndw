{
  "schemaVersion": 1,
  "backendDescriptor": {
    "required": [
      "endpoints",
      "websockets",
      "approval",
      "enabled",
      "public"
    ],
    "endpoint": {
      "method": "string",
      "path": "string",
      "csrf": "boolean?",
      "sensitive": "boolean?"
    },
    "websocket": {
      "path": "string",
      "protocols": "string[]?"
    },
    "approval": [
      "approved",
      "pending",
      "denied"
    ]
  },
  "errorEnvelope": {
    "required": [
      "error"
    ],
    "error": {
      "code": "string",
      "message": "string",
      "detail": "unknown|null"
    }
  }
}
