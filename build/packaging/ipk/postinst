#!/bin/sh
set -u

if [ "${1:-}" != "configure" ] && [ -n "${1:-}" ]; then
  exit 0
fi

MNDW_ROOT=${MNDW_ROOT:-/opt}
DATA_DIR="$MNDW_ROOT/var/lib/mndw"
MNDWD_INIT=${MNDW_MNDWD_INIT:-$MNDW_ROOT/etc/init.d/S70mndwd}
MNDW_FEED_CONF=${MNDW_FEED_CONF:-$MNDW_ROOT/etc/opkg/mndw-feed.conf}
MNDW_CACHE_DIR=${MNDW_CACHE_DIR:-$MNDW_ROOT/var/mndw/opkg-cache}
POLICY_FILE="$DATA_DIR/lighttpd-port-policy"
RRD_DIR="$DATA_DIR/rrd"

mkdir -p "$RRD_DIR"
chmod 0755 "$RRD_DIR"
chown 0:0 "$RRD_DIR"

if [ ! -e "$MNDW_FEED_CONF" ]; then
  mkdir -p "$(dirname "$MNDW_FEED_CONF")" "$MNDW_CACHE_DIR"
  {
    echo "src/gz mndw https://eralde.github.io/mndw-opkg-feed/__ARCH__"
    echo "option cache /opt/var/mndw/opkg-cache"
  } > "$MNDW_FEED_CONF"
fi

# One-time upgrade handoff from a lighttpd-fronted version. These are runtime
# artifacts, not package files, so remove them before the new daemon starts.
if [ -f "$DATA_DIR/lighttpd-runtime.conf" ] || [ -f "$DATA_DIR/proxy-target.conf" ] || [ -f "$DATA_DIR/lighttpd-port" ] || [ -f "$POLICY_FILE" ]; then
  if [ -f "$POLICY_FILE" ] && [ "$(cat "$POLICY_FILE" 2>/dev/null)" = "mndw" ]; then
    echo "[mndw] mndw no longer needs lighttpd. If nothing else uses it: opkg remove lighttpd" >&2
  fi

  rm -f "$DATA_DIR/lighttpd-runtime.conf" "$DATA_DIR/proxy-target.conf" "$MNDW_ROOT/etc/lighttpd/conf.d/81-mndw.conf" "$POLICY_FILE"
  HANDOFF=1
fi

"$MNDWD_INIT" restart
STATUS=$?

# Keep the old port as a migration seed until the new daemon has reported a
# successful front-door bind. A failed restart remains retryable.
if [ "${HANDOFF:-0}" = "1" ] && [ "$STATUS" -eq 0 ]; then
  rm -f "$DATA_DIR/lighttpd-port"
fi

exit "$STATUS"
