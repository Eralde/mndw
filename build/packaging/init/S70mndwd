#!/bin/sh

MNDW_ROOT=${MNDW_ROOT:-/opt}
PID_FILE="$MNDW_ROOT/var/run/mndwd.pid"
DAEMON="$MNDW_ROOT/sbin/mndwd"
DATA_DIR="$MNDW_ROOT/var/lib/mndw"
KEY_DIR="$MNDW_ROOT/var/lib/mndw-secrets"
PLUGIN_RUNTIME_DIR="$MNDW_ROOT/tmp/mndw/plugin-runtime"
CONFIG_FILE=${MNDW_CONFIG_FILE:-$MNDW_ROOT/etc/mndw.conf}
LOG_FILE="$MNDW_ROOT/var/log/mndwd.log"
DEVICE_PORT_HELPER=${MNDW_DEVICE_PORT_HELPER:-$MNDW_ROOT/share/www/mndw/bin/mndw-device-port.sh}

if [ -f "$CONFIG_FILE" ]; then
  . "$CONFIG_FILE"
fi

: "${MNDW_USER_PLUGINS_DIR:=$DATA_DIR/user-plugins}"
export MNDW_USER_PLUGINS_DIR

: "${MNDWD_MAX_CONCURRENT_EXEC_TOTAL:=8}"
: "${MNDWD_MAX_CONCURRENT_EXEC_PER_PLUGIN:=4}"
: "${MNDWD_MAX_SUPERVISED_SERVICES:=8}"
: "${MNDW_FRONTEND_LISTEN:=}"
: "${MNDW_DEVICE_PORT:=}"
export MNDW_DEVICE_PORT

wait_for_exit() {
  wait_pid="$1"
  wait_seconds="$2"
  while [ "$wait_seconds" -gt 0 ] && kill -0 "$wait_pid" 2>/dev/null; do
    sleep 1
    wait_seconds=$((wait_seconds - 1))
  done
  ! kill -0 "$wait_pid" 2>/dev/null
}

start() {
  mkdir -p "$MNDW_ROOT/var/run" "$MNDW_ROOT/var/log" "$DATA_DIR" "$KEY_DIR" "$PLUGIN_RUNTIME_DIR"
  chmod 700 "$DATA_DIR" "$KEY_DIR" "$PLUGIN_RUNTIME_DIR"

  # Resolve device IP on every boot because it may have changed.
  DEVICE_IP="$(ip -4 addr show br0 2>/dev/null | awk '/inet / {print $2}' | cut -d/ -f1 | head -n1)"
  DEVICE_IP="${DEVICE_IP:-192.168.1.1}"

  [ -x "$DEVICE_PORT_HELPER" ] || {
    echo "mndw: missing device port helper: $DEVICE_PORT_HELPER" >&2
    return 1
  }
  DEVICE_PORT="$($DEVICE_PORT_HELPER detect "$DEVICE_IP")" || {
    echo "mndw: unable to determine device /auth port for $DEVICE_IP" >&2
    return 1
  }

  if [ "$DEVICE_PORT" = "80" ]; then
    DEVICE_URL="http://$DEVICE_IP"
  else
    DEVICE_URL="http://$DEVICE_IP:$DEVICE_PORT"
  fi

  # Do not start a second daemon when one is already alive.
  if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
    return 0
  fi

  FRONTEND_LISTEN_ARG=""
  if [ -n "$MNDW_FRONTEND_LISTEN" ]; then
    FRONTEND_LISTEN_ARG="--frontend-listen $MNDW_FRONTEND_LISTEN"
  fi

PORT_FILE="$DATA_DIR/frontend-port"
MNDW_PORT_FILE="$PORT_FILE"
export MNDW_PORT_FILE
OLD_PORT_INODE="$(ls -id "$PORT_FILE" 2>/dev/null | awk '{print $1}')"

  # shellcheck disable=SC2086  # intentional word-split of FRONTEND_LISTEN_ARG
  "$DAEMON" \
    --frontend-dir "$MNDW_ROOT/share/www/mndw" \
    $FRONTEND_LISTEN_ARG \
    --data-dir "$DATA_DIR" \
    --rci-session-state-dir "$DATA_DIR" \
    --rci-session-key-dir "$KEY_DIR" \
    --builtin-plugins-dir "$MNDW_ROOT/share/www/mndw/plugins" \
    --user-plugins-dir "$MNDW_USER_PLUGINS_DIR" \
    --device-url "$DEVICE_URL" \
    --plugin-runtime-root "$PLUGIN_RUNTIME_DIR" \
    --max-concurrent-exec-total "$MNDWD_MAX_CONCURRENT_EXEC_TOTAL" \
    --max-concurrent-exec-per-plugin "$MNDWD_MAX_CONCURRENT_EXEC_PER_PLUGIN" \
    --max-supervised-services "$MNDWD_MAX_SUPERVISED_SERVICES" \
    --opkg exec \
    >> "$LOG_FILE" 2>&1 &
  echo "$!" > "$PID_FILE"

  MNDWD_PID="$(cat "$PID_FILE")"
  i=0
  NEW_PORT=""
  while [ "$i" -lt 20 ]; do
    kill -0 "$MNDWD_PID" 2>/dev/null || break
    CUR_PORT_INODE="$(ls -id "$PORT_FILE" 2>/dev/null | awk '{print $1}')"
    if [ -n "$CUR_PORT_INODE" ] && [ "$CUR_PORT_INODE" != "$OLD_PORT_INODE" ] && [ -s "$PORT_FILE" ]; then
      NEW_PORT="$(cat "$PORT_FILE" 2>/dev/null || true)"
      break
    fi
    sleep 1
    i=$((i + 1))
  done

  if [ -n "$NEW_PORT" ]; then
    echo "mndw dashboard: http://$DEVICE_IP:$NEW_PORT/" >&2
  else
    echo "mndw: dashboard port not reported (daemon may have failed to bind); check $LOG_FILE" >&2
    if ! kill -0 "$MNDWD_PID" 2>/dev/null; then
      rm -f "$PID_FILE"
    fi
    return 1
  fi
}

stop() {
  if [ ! -f "$PID_FILE" ]; then
    return 0
  fi
  pid="$(cat "$PID_FILE" 2>/dev/null || true)"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null || true
    if ! wait_for_exit "$pid" 60; then
      current_pid="$(cat "$PID_FILE" 2>/dev/null || true)"
      if [ "$current_pid" = "$pid" ]; then
        kill -KILL "$pid" 2>/dev/null || true
        wait_for_exit "$pid" 2
      fi
    fi
  fi
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    return 1
  fi
  rm -f "$PID_FILE"
}

restart() { stop || return 1; start; }

case "$1" in
  start)   start ;;
  stop)    stop ;;
  restart) restart ;;
  *)       echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
