{
  "manifestVersion": 3,
  "name": "mws-page",
  "version": "0.1.0",
  "type": "page",
  "label": "MWS Map",
  "route": "/mws",
  "entry": "index.js",
  "i18n": {"defaultLocale": "en", "locales": {"en": "i18n/en.json", "ru": "i18n/ru.json"}},
  "permissions": ["persistent-rci-session:write"],
  "backend": {
    "kind": "service",
    "protocolVersion": 1,
    "command": "backend/mwsd",
    "routes": [
      {"id": "nodes", "transport": "http", "method": "GET", "path": "nodes"},
      {"id": "write", "transport": "http", "method": "POST", "path": "write"}
    ]
  }
}
