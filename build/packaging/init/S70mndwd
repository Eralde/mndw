#!/bin/sh

MNDW_ROOT=${MNDW_ROOT:-/opt}
PID_FILE="$MNDW_ROOT/var/run/mndwd.pid"
PROC_ROOT=${MNDW_PROC_ROOT:-/proc}
DAEMON="$MNDW_ROOT/sbin/mndwd"
DATA_DIR="$MNDW_ROOT/var/lib/mndw"
KEY_DIR="$MNDW_ROOT/var/lib/mndw-secrets"
PLUGIN_RUNTIME_DIR="$MNDW_ROOT/tmp/mndw/plugin-runtime"
CONFIG_FILE=${MNDW_CONFIG_FILE:-$MNDW_ROOT/etc/mndw.conf}
CRASH_LOG_FILE="$MNDW_ROOT/var/log/mndwd.crash.log"
DEVICE_PORT_HELPER=${MNDW_DEVICE_PORT_HELPER:-$MNDW_ROOT/share/www/mndw/bin/mndw-device-port.sh}

if [ -f "$CONFIG_FILE" ]; then
  . "$CONFIG_FILE"
fi

: "${MNDW_USER_PLUGINS_DIR:=$DATA_DIR/user-plugins}"
export MNDW_USER_PLUGINS_DIR

: "${MNDWD_MAX_CONCURRENT_EXEC_TOTAL:=8}"
: "${MNDWD_MAX_CONCURRENT_EXEC_PER_PLUGIN:=4}"
: "${MNDWD_MAX_SUPERVISED_SERVICES:=8}"
: "${MNDW_FRONTEND_LISTEN:=}"
: "${MNDW_DEVICE_PORT:=}"
: "${MNDW_START_WAIT_SECONDS:=60}"
: "${MNDW_START_RETRY_INTERVAL:=2}"
export MNDW_DEVICE_PORT

log_err() {
  printf '%s\n' "$1" >&2
  if command -v logger >/dev/null 2>&1; then
    logger -t mndw "$1" >/dev/null 2>&1 || true
  fi
}

read_device_ip() {
  DEVICE_IP="$(ip -4 addr show br0 2>/dev/null | awk '/inet / {print $2}' | cut -d/ -f1 | head -n1)"
}

remaining_start_seconds() {
  START_NOW="$(date +%s 2>/dev/null)"
  case "$START_NOW" in
    ''|*[!0-9]*) START_NOW=0 ;;
  esac
  START_REMAINING=$((START_DEADLINE - START_NOW))
  [ "$START_REMAINING" -gt 0 ] || START_REMAINING=0
}

forward_helper_stderr() {
  [ -f "$HELPER_STDERR_FILE" ] || return 0

  while IFS= read -r HELPER_LINE || [ -n "$HELPER_LINE" ]; do
    log_err "$HELPER_LINE"
  done < "$HELPER_STDERR_FILE"
}

port_is_valid() {
  case "$1" in
    ''|*[!0-9]*) return 1 ;;
  esac

  PORT_DECIMAL="$(printf '%s\n' "$1" | sed 's/^0*//')"
  PORT_DECIMAL=${PORT_DECIMAL:-0}
  [ "$PORT_DECIMAL" -ge 1 ] 2>/dev/null && [ "$PORT_DECIMAL" -le 65535 ] 2>/dev/null
}

daemon_pid() {
  if [ ! -f "$PID_FILE" ]; then
    return 1
  fi

  raw_pid="$(cat "$PID_FILE" 2>/dev/null || true)"
  pid="$(printf '%s' "$raw_pid" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
  case "$pid" in
    ''|*[!0-9]*) return 1 ;;
  esac

  if ! kill -0 "$pid" 2>/dev/null; then
    return 1
  fi

  process_name="$(tr '\000' '\n' 2>/dev/null < "$PROC_ROOT/$pid/cmdline" | head -n 1)"
  if [ "$process_name" != "$DAEMON" ]; then
    return 1
  fi

  printf '%s\n' "$pid"
}

wait_for_exit() {
  wait_pid="$1"
  wait_seconds="$2"
  while [ "$wait_seconds" -gt 0 ] && kill -0 "$wait_pid" 2>/dev/null; do
    sleep 1
    wait_seconds=$((wait_seconds - 1))
  done
  ! kill -0 "$wait_pid" 2>/dev/null
}

start() {
  if daemon_pid >/dev/null; then
    return 0
  fi

  START_WAIT_SECONDS="$MNDW_START_WAIT_SECONDS"
  case "$START_WAIT_SECONDS" in
    ''|*[!0-9]*) START_WAIT_SECONDS=60 ;;
  esac
  START_WAIT_SECONDS="$(printf '%s\n' "$START_WAIT_SECONDS" | sed 's/^0*//')"
  START_WAIT_SECONDS=${START_WAIT_SECONDS:-0}

  START_RETRY_INTERVAL="$MNDW_START_RETRY_INTERVAL"
  case "$START_RETRY_INTERVAL" in
    ''|*[!0-9]*) START_RETRY_INTERVAL=2 ;;
  esac
  START_RETRY_INTERVAL="$(printf '%s\n' "$START_RETRY_INTERVAL" | sed 's/^0*//')"
  START_RETRY_INTERVAL=${START_RETRY_INTERVAL:-0}

  START_NOW="$(date +%s 2>/dev/null)"
  case "$START_NOW" in
    ''|*[!0-9]*) START_NOW=0 ;;
  esac
  START_DEADLINE=$((START_NOW + START_WAIT_SECONDS))

  mkdir -p "$MNDW_ROOT/var/run" "$MNDW_ROOT/var/log" "$DATA_DIR" "$KEY_DIR" "$PLUGIN_RUNTIME_DIR" 2>/dev/null || {
    log_err 'mndw: unable to create runtime directories'
    return 1
  }
  chmod 700 "$DATA_DIR" "$KEY_DIR" "$PLUGIN_RUNTIME_DIR" 2>/dev/null || {
    log_err 'mndw: unable to set runtime directory permissions'
    return 1
  }

  # rc.unslung runs init scripts serially, so later S* scripts also wait
  # during this readiness window.
  # Resolve device IP on every boot because it may have changed.
  read_device_ip
  while [ -z "$DEVICE_IP" ] && [ "$START_WAIT_SECONDS" -gt 0 ]; do
    remaining_start_seconds
    [ "$START_REMAINING" -gt 0 ] || break

    START_SLEEP="$START_RETRY_INTERVAL"
    [ "$START_SLEEP" -le "$START_REMAINING" ] || START_SLEEP="$START_REMAINING"
    sleep "$START_SLEEP"
    read_device_ip
  done

  if [ -z "$DEVICE_IP" ]; then
    DEVICE_IP=192.168.1.1
    log_err "mndw: br0 has no IPv4 address; using fallback $DEVICE_IP"
  fi

  [ -x "$DEVICE_PORT_HELPER" ] || {
    log_err "mndw: missing device port helper: $DEVICE_PORT_HELPER"
    return 1
  }

  remaining_start_seconds
  if [ "$START_WAIT_SECONDS" -gt 0 ] && [ "$START_REMAINING" -eq 0 ]; then
    log_err 'mndw: startup wait expired before device port detection'
    return 1
  fi

  HELPER_STDERR_FILE="$MNDW_ROOT/var/run/mndwd-device-port.$$.stderr"
  HELPER_OLD_UMASK="$(umask)"
  umask 077
  : > "$HELPER_STDERR_FILE" 2>/dev/null || {
    umask "$HELPER_OLD_UMASK"
    log_err "mndw: unable to capture device port helper output: $HELPER_STDERR_FILE"
    return 1
  }
  umask "$HELPER_OLD_UMASK"

  while :; do
    DEVICE_PORT="$($DEVICE_PORT_HELPER detect "$DEVICE_IP" 2>"$HELPER_STDERR_FILE")"
    DETECT_STATUS=$?
    if [ "$DETECT_STATUS" -eq 0 ]; then
      rm -f "$HELPER_STDERR_FILE"
      break
    fi

    if [ "$DETECT_STATUS" -ne 3 ] || [ "$START_WAIT_SECONDS" -eq 0 ]; then
      forward_helper_stderr
      rm -f "$HELPER_STDERR_FILE"
      return 1
    fi

    remaining_start_seconds
    if [ "$START_REMAINING" -eq 0 ]; then
      forward_helper_stderr
      rm -f "$HELPER_STDERR_FILE"
      return 1
    fi

    START_SLEEP="$START_RETRY_INTERVAL"
    [ "$START_SLEEP" -le "$START_REMAINING" ] || START_SLEEP="$START_REMAINING"
    sleep "$START_SLEEP"

    remaining_start_seconds
    if [ "$START_REMAINING" -eq 0 ]; then
      forward_helper_stderr
      rm -f "$HELPER_STDERR_FILE"
      return 1
    fi
  done

  if [ "$DEVICE_PORT" = "80" ]; then
    DEVICE_URL="http://$DEVICE_IP"
  else
    DEVICE_URL="http://$DEVICE_IP:$DEVICE_PORT"
  fi

  if [ -f "$PID_FILE" ]; then
    raw_pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    log_err "mndw: ignoring stale pid file $PID_FILE (pid $raw_pid is not mndwd)"
  fi

  if [ -s "$CRASH_LOG_FILE" ]; then
    mv -f "$CRASH_LOG_FILE" "$CRASH_LOG_FILE.1" 2>/dev/null || {
      log_err "mndw: unable to preserve previous crash log: $CRASH_LOG_FILE"
      return 1
    }
  fi
  : > "$CRASH_LOG_FILE" 2>/dev/null || {
    log_err "mndw: unable to create crash log: $CRASH_LOG_FILE"
    return 1
  }

  FRONTEND_LISTEN_ARG=""
  if [ -n "$MNDW_FRONTEND_LISTEN" ]; then
    FRONTEND_LISTEN_ARG="--frontend-listen $MNDW_FRONTEND_LISTEN"
  fi

  PORT_FILE="$DATA_DIR/frontend-port"
  MNDW_PORT_FILE="$PORT_FILE"
  export MNDW_PORT_FILE
  OLD_PORT_INODE="$(ls -id "$PORT_FILE" 2>/dev/null | awk '{print $1}')"

  # shellcheck disable=SC2086  # intentional word-split of FRONTEND_LISTEN_ARG
  "$DAEMON" \
    --frontend-dir "$MNDW_ROOT/share/www/mndw" \
    $FRONTEND_LISTEN_ARG \
    --data-dir "$DATA_DIR" \
    --rci-session-state-dir "$DATA_DIR" \
    --rci-session-key-dir "$KEY_DIR" \
    --builtin-plugins-dir "$MNDW_ROOT/share/www/mndw/plugins" \
    --user-plugins-dir "$MNDW_USER_PLUGINS_DIR" \
    --device-url "$DEVICE_URL" \
    --plugin-runtime-root "$PLUGIN_RUNTIME_DIR" \
    --max-concurrent-exec-total "$MNDWD_MAX_CONCURRENT_EXEC_TOTAL" \
    --max-concurrent-exec-per-plugin "$MNDWD_MAX_CONCURRENT_EXEC_PER_PLUGIN" \
    --max-supervised-services "$MNDWD_MAX_SUPERVISED_SERVICES" \
    --log-file /tmp/mndwd.log \
    --diagnostics-crash-log-file "$CRASH_LOG_FILE" \
    --opkg exec \
    > "$CRASH_LOG_FILE" 2>&1 &
  MNDWD_PID=$!
  printf '%s\n' "$MNDWD_PID" > "$PID_FILE" 2>/dev/null || {
    kill "$MNDWD_PID" 2>/dev/null || true
    rm -f "$PID_FILE" 2>/dev/null || true
    log_err "mndw: unable to write pid file: $PID_FILE"
    return 1
  }

  i=0
  NEW_PORT=""
  while [ "$i" -lt 20 ]; do
    kill -0 "$MNDWD_PID" 2>/dev/null || break
    CUR_PORT_INODE="$(ls -id "$PORT_FILE" 2>/dev/null | awk '{print $1}')"
    if [ -n "$CUR_PORT_INODE" ] && [ "$CUR_PORT_INODE" != "$OLD_PORT_INODE" ] && [ -s "$PORT_FILE" ]; then
      NEW_PORT="$(cat "$PORT_FILE" 2>/dev/null || true)"
      break
    fi
    sleep 1
    i=$((i + 1))
  done

  if [ -n "$NEW_PORT" ]; then
    echo "mndw dashboard: http://$DEVICE_IP:$NEW_PORT/" >&2
  else
    log_err "mndw: dashboard port not reported (daemon may have failed to bind); check $CRASH_LOG_FILE and /tmp/mndwd.log"
    if ! kill -0 "$MNDWD_PID" 2>/dev/null; then
      rm -f "$PID_FILE"
    fi
    return 1
  fi
}

stop() {
  if [ ! -f "$PID_FILE" ]; then
    return 0
  fi
  pid="$(daemon_pid)" || {
    raw_pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    echo "mndw: ignoring stale pid file $PID_FILE (pid $raw_pid is not mndwd)" >&2
    rm -f "$PID_FILE"
    return 0
  }

  kill "$pid" 2>/dev/null || true
  if ! wait_for_exit "$pid" 60; then
    if [ "$(daemon_pid)" = "$pid" ]; then
      kill -KILL "$pid" 2>/dev/null || true
      wait_for_exit "$pid" 2
    fi
  fi

  if [ "$(daemon_pid)" = "$pid" ]; then
    return 1
  fi
  rm -f "$PID_FILE"
}

print_status_logs() {
  STATUS_LOGS=""
  if [ -f "$CRASH_LOG_FILE" ]; then
    STATUS_LOGS="$CRASH_LOG_FILE"
  fi
  if [ -f /tmp/mndwd.log ]; then
    if [ -n "$STATUS_LOGS" ]; then
      STATUS_LOGS="$STATUS_LOGS, /tmp/mndwd.log"
    else
      STATUS_LOGS=/tmp/mndwd.log
    fi
  fi
  if [ -n "$STATUS_LOGS" ]; then
    printf 'logs: %s\n' "$STATUS_LOGS"
  fi
}

status() {
  STATUS_PID="$(daemon_pid)" && {
    printf 'mndwd is running (pid %s)\n' "$STATUS_PID"

    STATUS_VERSION="$("$DAEMON" --version 2>/dev/null)"
    STATUS_VERSION_STATUS=$?
    if [ "$STATUS_VERSION_STATUS" -eq 0 ]; then
      STATUS_VERSION="$(printf '%s\n' "$STATUS_VERSION" | head -n 1)"
    fi
    if [ "$STATUS_VERSION_STATUS" -eq 0 ] && [ -n "$STATUS_VERSION" ]; then
      printf 'version: %s\n' "$STATUS_VERSION"
    fi

    read_device_ip
    PORT_FILE="$DATA_DIR/frontend-port"
    STATUS_PORT="$(cat "$PORT_FILE" 2>/dev/null || true)"
    if [ -n "$DEVICE_IP" ] && port_is_valid "$STATUS_PORT"; then
      printf 'dashboard: http://%s:%s/\n' "$DEVICE_IP" "$STATUS_PORT"
    fi
    return 0
  }

  if [ -f "$PID_FILE" ]; then
    printf 'mndwd is not running (stale pid file %s)\n' "$PID_FILE"
    print_status_logs
    return 1
  fi

  printf 'mndwd is not running\n'
  print_status_logs
  return 3
}

restart() { stop || return 1; start; }

case "$1" in
  start)   start ;;
  stop)    stop ;;
  restart) restart ;;
  status|check) status ;;
  *)       echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
