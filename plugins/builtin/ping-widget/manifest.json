{
  "manifestVersion": 2,
  "name": "ping-widget",
  "version": "1.1.0",
  "type": "widget",
  "label": "Ping Utility",
  "entry": "index.js",
  "size": {"w": 6, "h": 4, "minW": 4, "minH": 3},
  "backend": {
    "assets": ["backend/ping-util"],
    "daemon": {"start": "backend/start.sh", "stop": "backend/stop.sh"},
    "scripts": [
      {"id": "stats", "runtime": "sh", "source": "backend/stats.sh"},
      {"id": "hosts", "runtime": "sh", "source": "backend/hosts.sh"},
      {"id": "daemonStart", "runtime": "sh", "source": "backend/start.sh"},
      {"id": "daemonStop", "runtime": "sh", "source": "backend/stop.sh"}
    ],
    "endpoints": [
      {"id": "stats", "method": "GET", "path": "stats", "scriptId": "stats"},
      {"id": "hosts", "method": "GET", "path": "hosts", "scriptId": "hosts"},
      {"id": "hostsUpdate", "method": "POST", "path": "hosts", "scriptId": "hosts"},
      {"id": "daemonStart", "method": "POST", "path": "daemon/start", "scriptId": "daemonStart"},
      {"id": "daemonStop", "method": "POST", "path": "daemon/stop", "scriptId": "daemonStop"}
    ]
  }
}
