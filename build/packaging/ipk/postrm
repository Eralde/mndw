#!/bin/sh
set -u

if [ "${1:-}" != "remove" ]; then
  exit 0
fi

MNDW_ROOT=${MNDW_ROOT:-/opt}
APP_ROOT="$MNDW_ROOT/share/www/mndw"
MNDWD_INIT=${MNDW_MNDWD_INIT:-$MNDW_ROOT/etc/init.d/S70mndwd}
LIGHTTPD_INIT=${MNDW_LIGHTTPD_INIT:-$MNDW_ROOT/etc/init.d/S80lighttpd}

if [ -x "$MNDWD_INIT" ]; then
  sh "$MNDWD_INIT" stop || true
fi

rm -f "$MNDW_ROOT/var/run/mndwd.pid"
rm -f "$MNDW_ROOT/etc/lighttpd/conf.d/81-mndw.conf"
rm -f "$MNDW_ROOT/var/lib/mndw/lighttpd-runtime.conf"

if [ -x "$LIGHTTPD_INIT" ]; then
  if ! sh "$LIGHTTPD_INIT" restart >/dev/null 2>&1; then
    echo '[mndw] warning: remaining lighttpd configuration could not restart after removal' >&2
  fi
fi

if [ -d "$APP_ROOT" ]; then
  rm -rf "$APP_ROOT"
fi

# /opt/var/lib/mndw/ data dir, /opt/var/lib/mndw-secrets/ key dir, and
# /opt/var/log/mndwd.log are preserved for reinstall. Key dir is intentionally
# outside exportable daemon state and is never removed by this script.

exit 0
