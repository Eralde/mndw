#!/bin/sh
HOOK_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd) || exit 0
. "$HOOK_ROOT/mndw-hook-common.sh"
action=${1:-}
payload="\"usb_device\":\"$(escape "${usb_device:-}")\",\"port\":\"$(escape "${usb_port:-}")\""
if [ "$action" = stop ]; then post "{\"hook\":\"usb.d\",\"action\":\"stop\",\"payload\":{$payload}}"; else post "{\"hook\":\"usb.d\",\"action\":\"start\",\"payload\":{${payload},\"model\":\"$(escape "${usb_model:-}")\",\"vendor\":\"$(escape "${usb_vendor:-}")\"}}"; fi
