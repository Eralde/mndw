{
  "manifestVersion": 1,
  "name": "dns-lookup-widget",
  "version": "0.1.0",
  "type": "widget",
  "label": "DNS Lookup",
  "entry": "index.js",
  "i18n": {"defaultLocale": "en", "locales": {"en": "i18n/en.json", "ru": "i18n/ru.json"}},
  "size": {"w": 4, "h": 4, "minW": 3, "minH": 3},
  "backend": {
    "kind": "exec",
    "routes": [
      {"id": "lookup", "transport": "http", "method": "GET", "path": "lookup", "command": "backend/lookup.sh"}
    ]
  }
}
