{
  "manifestVersion": 2,
  "name": "backend-plugin",
  "version": "2.0.0",
  "type": "widget",
  "label": "Test Widget",
  "entry": "index.js",
  "size": {
    "w": 4,
    "h": 3
  },
  "backend": {
    "scripts": [
      {
        "id": "hook",
        "source": "hook.sh",
        "runtime": "sh"
      }
    ],
    "endpoints": [
      {
        "id": "hook",
        "method": "POST",
        "path": "hook",
        "scriptId": "hook"
      }
    ],
    "public": true
  }
}
