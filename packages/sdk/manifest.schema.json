                  "method",
                  "scriptId"
                ],
                "additionalProperties": false
              }
            },
            "websockets": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "target": {
                    "type": "string",
                    "minLength": 1
                  },
                  "protocols": {
                    "type": "array",
                    "items": {
